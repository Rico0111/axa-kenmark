# Application
APP_NAME="Kenneth | AXA Philippines"
APP_ENV=local
APP_DEBUG=false
APP_URL=http://axa-kenmark.test
APP_KEY=replace-with-a-64-character-random-string
APP_TIMEZONE=Asia/Manila

# Sessions
SESSION_NAME=axa_kenneth_session
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
# Set to true only when a trusted reverse proxy terminates HTTPS.
TRUST_PROXY_HEADERS=false

# Privacy notice version recorded with every consent
PRIVACY_NOTICE_VERSION=2026-10-22

# Runtime database account (least privilege: SELECT, INSERT, UPDATE, DELETE)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=axa_kenneth_db
DB_USER=REPLACE_WITH_LOCAL_DATABASE_USER
DB_PASSWORD=

# Migration/seed account (DDL on axa_kenneth_db only)
DB_MIGRATION_USER=REPLACE_WITH_LOCAL_MIGRATION_USER
DB_MIGRATION_PASSWORD=

# Upload limit for images (5 MiB)
MEDIA_MAX_BYTES=5242880
