# Copy to .env at the PROJECT ROOT after extraction. Never upload local .env.
APP_NAME="Kenneth | AXA Philippines"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://techtalkmnl.com/axa-kenmark/
# Generate with: php scripts/generate-key.php (do not reuse the local key)
APP_KEY=REPLACE_WITH_UNIQUE_64_CHAR_HEX_KEY
APP_TIMEZONE=Asia/Manila
SESSION_NAME=axa_kenneth_session
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
TRUST_PROXY_HEADERS=false
PRIVACY_NOTICE_VERSION=2026-10-22

# Use the exact hostname and prefixed database/user shown in hPanel.
DB_HOST=REPLACE_WITH_HOSTINGER_MYSQL_HOST
DB_PORT=3306
DB_NAME=REPLACE_WITH_HOSTINGER_DATABASE_NAME
DB_USER=REPLACE_WITH_HOSTINGER_DATABASE_USER
# Single quotes preserve literal backslashes and dollar signs in passwords.
DB_PASSWORD='REPLACE_WITH_HOSTINGER_DATABASE_PASSWORD'
DB_CHARSET=utf8mb4
# Only needed for CLI migrations/seeds; hPanel may use the same database user.
DB_MIGRATION_USER=REPLACE_WITH_HOSTINGER_DATABASE_USER
DB_MIGRATION_PASSWORD='REPLACE_WITH_HOSTINGER_DATABASE_PASSWORD'
MEDIA_MAX_BYTES=5242880
# Leave PUBLIC_PATH unset: the application detects the existing public/ folder.
