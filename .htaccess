# Repository-root deployment: keep app/, public/, storage/, etc. in place.
# Requires Apache 2.4 / compatible LiteSpeed, AllowOverride All, mod_rewrite.
Options -Indexes -MultiViews
DirectoryIndex index.php
ErrorDocument 403 "Access denied."
ErrorDocument 404 "Not found."

# Fail closed if rewriting is unavailable.
<IfModule !mod_rewrite.c>
  Require all denied
</IfModule>

<FilesMatch "(?i)(^\.|\.(env|ini|log|sql|dump|bak|backup|zip|gz|7z|tar|sh|bat|cmd|ps1|example|md|json|ya?ml|lock)(\.|$)|~$)">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Deny internals BEFORE any filesystem checks or public rewrites.
  RewriteRule ^(app|config|database|docs|scripts|storage|tests|backups|dist|private|vendor|node_modules|public)(/|$) - [F,END,NC]
  RewriteRule (^|/)\. - [F,END]
  # This text endpoint is generated by PHP, never read from a disk text file.
  RewriteRule ^robots\.txt$ public/index.php [END]
  RewriteRule \.(env|ini|log|sql|dump|bak|backup|zip|gz|7z|tar|sh|bat|cmd|ps1|example|md|txt|json|ya?ml|lock)(\.|$) - [F,END,NC]
  RewriteCond %{THE_REQUEST} (\.\./|%2e%2e|%5c) [NC]
  RewriteRule ^ - [F,END]

  # Only approved static asset types may bypass PHP. Never execute asset PHP.
  RewriteRule ^assets/(.+\.(?:css|js|jpg|jpeg|png|gif|webp|ico|svg|woff2?|ttf))$ public/assets/$1 [END,NC]
  RewriteRule ^favicon\.ico$ public/favicon.ico [END]
  RewriteRule ^admin/?$ public/admin/index.php [END]
  RewriteRule ^admin/(index|login)\.php$ public/admin/$1.php [END]
  RewriteRule ^admin/ - [R=404,END]
  # END prevents a second per-directory rewrite from exposing /public/.
  RewriteRule ^ public/index.php [END]
</IfModule>
